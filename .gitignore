# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is placeholder-only and is the thing a fresh
# clone needs in order to know WHICH variables to set. `.env*` above was
# swallowing it, so it had never been committed.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude screenshots
.claude/screenshots/

# Downloaded source photos cached by the knockout scripts. Regenerable, and
# they are manufacturer product photography we hold no licence to redistribute.
.claude/scripts/.cache/

# Scraper: the scripts are tracked, the scraped data dumps are not.
# (pedal.schema.json is the schema they validate against, not output.)
scraper/*.json
!scraper/pedal.schema.json
# pedal_jacks.json is NOT a dump - it is hand-researched jack layouts with a
# source URL per pedal, reviewed as data. Regenerating it means doing the
# research again, so it is tracked like source.
!scraper/pedal_jacks.json

supabase/backups/
.dev.db
supabase/.temp/
public/repro/

# Local rollback copies of Supabase Storage. `.backups/pedal-images-2026-08-21`
# is the byte-exact set of originals taken before the 2026-08-21 re-encode
# (85 objects, 77.56 MB, up to 3014px) - re-uploading it restores the bucket
# exactly. 78 MB of binary that must never reach the repository, and must
# never be deleted casually either: it is the only copy of the originals.
.backups/
