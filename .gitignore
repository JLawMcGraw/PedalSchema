# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude screenshots
.claude/screenshots/

# Scraper: the scripts are tracked, the scraped data dumps are not.
# (pedal.schema.json is the schema they validate against, not output.)
scraper/*.json
!scraper/pedal.schema.json
# pedal_jacks.json is NOT a dump - it is hand-researched jack layouts with a
# source URL per pedal, reviewed as data. Regenerating it means doing the
# research again, so it is tracked like source.
!scraper/pedal_jacks.json

supabase/backups/
.dev.db
supabase/.temp/
public/repro/
