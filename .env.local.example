# Copy to .env.local and fill in. .env.local is gitignored and must STAY that
# way - this repo's remote is public.
#
# Get the Supabase values from Project Settings -> API:
#   https://app.supabase.com/project/_/settings/api

# --- Required: the app itself ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Required by scraper/ and .claude/scripts/ only, never by the browser ---
# Bypasses RLS. Do NOT prefix with NEXT_PUBLIC_ and do NOT commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A real login the Playwright verification scripts sign in as. Use a throwaway
# account - the scripts drive the editor as this user.
VERIFY_EMAIL=you@example.com
VERIFY_PASSWORD=your-password
